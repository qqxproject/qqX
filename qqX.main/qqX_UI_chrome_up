qqX_logo_printf_title() {
  # printf version (no end line feed & also avoids the quickemu echo trap)
  if [[ $1 ]]; then qqX_LogoTxt="$1" ; else qqX_LogoTxt="$qqX_title" ; fi
  printColor "\n  _    _   \/   "
  printColor "\n (_|  (_|  /\ "
  printColor "\n   |.   |.     %s"  "$qqX_LogoTxt"
}


function exit {

  # trap to keep terminal open if started by mouse click  -t secs
  # or to stop sourced quickemu quitting as 'normal' procedure   (tput resets any hidden cursors)
  # https://unix.stackexchange.com/questions/220330/hide-and-unhide-cursor-with-tput

  if [[ $1 == "directly" ]]; then
    printf "\n  Stopping current qqX process .... \n\n"
    sleep 1.4 ; tput cnorm ; tput clear
    [[ $DolphinExitPid ]] && kill "$DolphinExitPid"
    command exit

  elif [[ $1 ]] && [[ ! $NoExit ]]; then
    ExitTrap=
    printf "\n\n"
    printColor "  ERROR :    [c] ignore and continue  [m] attempt return to menus  [q] quit  \n\n"
    read -rp  "  >  "  ExitTrap
    if [[ $ExitTrap != "m" ]]; then
      ExitTrap=
      printf "\n\n  CONFIRM >  [c] ignore and continue  [m] attempt return to menus  [q] quit  \n\n"
      read -rp "  >  "  ExitTrap
      printf "\n\n"
    fi
    if [[ $ExitTrap == "q" ]]; then
      printf "  Stopping current qqX process .... \n\n"
      sleep 1.4 ; tput cnorm ; tput clear
      [[ $DolphinExitPid ]] && kill "$DolphinExitPid"
      command exit "$@"
    # 'm' attempts a return, given an error situation exists
    elif [[ $ExitTrap == "c" ]]; then true
    else RouteToMenus=1
    fi
    ExitTrap=
    return

  elif [[ ! $disk_img ]]; then
    # don't exit on quickemu error no disk defined, this is handled by qqX  REVIEW
    return

  fi

  # zero the optional 'exit 1' bypass flag (if it has been set)
  NoExit=
}

